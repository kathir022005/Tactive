{
  "name": "equipflow-qa-assessment",
  "version": "1.0.0",
  "description": "EquipFlow - AI-Powered Corporate Equipment & Asset Reservation System with QA Test Automation & AI Change Loop",
  "main": "dist/server/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:red": "tsx tests/scripts/run-red-run.ts"
  },
  "keywords": [
    "qa-automation",
    "playwright",
    "vitest",
    "express",
    "react",
    "tactive-assessment"
  ],
  "author": "Assessment Submission",
  "license": "MIT",
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "mongoose": "^9.9.2",
    "pdfkit": "^0.19.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
